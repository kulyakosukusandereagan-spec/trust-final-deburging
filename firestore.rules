rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Tenants & Branches Collection
    match /tenants/{tenantId} {
      allow read, write: if true;
    }

    // 2. Transactions Collection (Sales & Branch Isolations)
    match /transactions/{txId} {
      allow read, write: if true;
    }

    // 3. Drugs & Formulations Catalog
    match /drugs/{drugId} {
      allow read, write: if true;
    }

    // 4. Batch Stock Batches & Inventory
    match /batches/{batchId} {
      allow read, write: if true;
    }

    // 5. Prescriptions & Clinical Records
    match /prescriptions/{rxId} {
      allow read, write: if true;
    }

    // 6. Branch Expenditures
    match /expenditures/{expId} {
      allow read, write: if true;
    }

    // 7. Customers Directory
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // 8. Branch Staff & Staff Accounts
    match /staff/{staffId} {
      allow read, write: if true;
    }

    match /staff_accounts/{accId} {
      allow read, write: if true;
    }

    match /deleted_staff/{delId} {
      allow read, write: if true;
    }

    match /deleted_batches/{delId} {
      allow read, write: if true;
    }

    match /inventory_cleared/{delId} {
      allow read, write: if true;
    }

    match /stock_movements/{movId} {
      allow read, write: if true;
    }

    // 9. Compliance & Audit Logs
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // 10. User Accounts
    match /users/{userId} {
      allow read, write: if true;
    }

    match /system_config/{configId} {
      allow read, write: if true;
    }

    match /deleted_branches/{delId} {
      allow read, write: if true;
    }

    // Default Fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}




