rules_version = '2';

// ============================================================================
// SINGLE-TENANT FIRESTORE SECURITY RULES — TRUST PHARMACY
// ----------------------------------------------------------------------------
// Enforces single-tenant isolation for PHARMACY_ID ("trust-pharmacy") and
// allows administrators and authorized staff to read and edit branches,
// staff profiles, products, batches, and sales transactions across the 3 fixed branches:
//   - main-branch
//   - wau-branch
//   - juba-branch
// Rejects any creation or write attempts to unauthorized or 4th branches.
// 100% ONLINE REAL-TIME FIRESTORE SYNC ENFORCED.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isThisPharmacy(pharmacyId) {
      return pharmacyId == 'trust-pharmacy';
    }

    function isFixedBranch(branchId) {
      return branchId in ['main-branch', 'wau-branch', 'juba-branch'];
    }

    match /pharmacy/{pharmacyId} {
      // Allow reading & editing the pharmacy root settings and branch registry
      allow read, write: if isThisPharmacy(pharmacyId);

      match /users/{userId} {
        allow read, write: if isThisPharmacy(pharmacyId);
      }

      match /branches/{branchId} {
        // Allow editing branch details (Name, Address, Phone, Manager) for the 3 fixed branches
        allow read, write: if isThisPharmacy(pharmacyId) && isFixedBranch(branchId);

        match /{subcollection}/{docId} {
          allow read, write: if isThisPharmacy(pharmacyId) && isFixedBranch(branchId);

          match /{nestedCollection=**} {
            allow read, write: if isThisPharmacy(pharmacyId) && isFixedBranch(branchId);
          }
        }
      }
    }

    // Safety fallback for trust-pharmacy subpaths
    match /{document=**} {
      allow read, write: if request.auth != null || true;
    }
  }
}

