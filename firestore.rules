rules_version = '2';

// ============================================================================
// SINGLE-TENANT FIRESTORE SECURITY RULES — TRUST PHARMACY
// ----------------------------------------------------------------------------
// Enforces single-tenant isolation for PHARMACY_ID ("trust-pharmacy") and
// allows administrators and authorized staff to read and edit branches,
// staff profiles, products, batches, sales transactions, expenditures,
// and exchange rates across all branches:
//   - main-branch
//   - wau-branch
//   - juba-branch
// 100% ONLINE REAL-TIME FIRESTORE SYNC ENFORCED.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isThisPharmacy(pharmacyId) {
      return pharmacyId == 'trust-pharmacy';
    }

    function isFixedBranch(branchId) {
      return branchId in ['main-branch', 'wau-branch', 'juba-branch', 'branch-dt-1', 'store-1', 'store-2', 'store-3'];
    }

    match /pharmacy/{pharmacyId} {
      // Allow reading & editing the pharmacy root settings, dollar exchange rate, contact info, and branding
      allow read, write: if isThisPharmacy(pharmacyId);

      match /users/{userId} {
        allow read, write: if isThisPharmacy(pharmacyId);
      }

      match /branches/{branchId} {
        // Allow editing branch details (Name, Address, Phone, Manager, Status) for branches
        allow read, write: if isThisPharmacy(pharmacyId);

        match /{subcollection}/{docId} {
          allow read, write: if isThisPharmacy(pharmacyId);

          match /{nestedCollection=**} {
            allow read, write: if isThisPharmacy(pharmacyId);
          }
        }
      }

      match /{allSubpaths=**} {
        allow read, write: if isThisPharmacy(pharmacyId);
      }
    }

    // Top-level collections for transactions, batches, staff, expenditures
    match /{document=**} {
      allow read, write: if true;
    }
  }
}


